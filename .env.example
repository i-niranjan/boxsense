# Copy to .env and fill in. Never commit .env.

# Meta Model API (SAM 3.1 + Muse Spark)
META_API_KEY=
META_API_BASE=

# 1 = fake SAM detections (a box in the middle of every keyframe), for testing the pipeline without the API
SAM_MOCK=1

# Comma-separated text prompts sent to SAM 3.1
SAM_PROMPTS=cardboard box

# Object memory mode: none | position | full  (also the eval baselines)
MEMORY_MODE=position

# Replay a recording instead of waiting for the phone, e.g. recordings/2026-10-30T10-00-00
REPLAY=

PORT=8787
